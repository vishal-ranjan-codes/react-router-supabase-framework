{
  "include": [
    ".react-router/types/**/*",
    "app/**/*",
    "app/**/.server/**/*.ts",
    "app/**/.server/**/*.tsx",
    "app/**/.client/**/*.ts",
    "app/**/.client/**/*.tsx",
    "workers/**/*",
    "worker-configuration.d.ts",
    "tests/**/*"
  ],
  "exclude": ["tests/**/*.test.ts"],
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["vite/client"],
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "rootDirs": [".", "./.react-router/types"],
    "paths": {
      "~/*": ["./app/*"]
    }
  }
}
