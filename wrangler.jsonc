{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "react-router-supabase-starter",
  "compatibility_date": "2025-07-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "./workers/app.ts",
  "assets": {
    "directory": "./build/client"
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "0 * * * *",
      "0 0 * * *"
    ]
  },
  "vars": {
    "SUPABASE_URL": "",
    "SUPABASE_PUBLISHABLE_KEY": ""
  }
}
