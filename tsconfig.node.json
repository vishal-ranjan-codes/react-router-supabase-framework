{
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "react-router.config.ts",
    "e2e/**/*.ts",
    "tests/**/*.test.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "lib": ["ES2023"],
    "types": ["node"],
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  }
}
