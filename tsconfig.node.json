{
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "react-router.config.ts",
    "e2e/**/*.ts",
    "tests/**/*.test.ts",
    "tests/**/*.d.ts",
    "app/lib/design-system.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    // `DOM` because `page.evaluate` callbacks run in the browser, not in Node.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  }
}
