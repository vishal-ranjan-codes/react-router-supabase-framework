# Browser-side vars only. Vite statically inlines any VITE_* value into the JS bundle, so a
# secret placed here is published to every visitor - server bindings live in .dev.vars.example
# locally and `wrangler secret put` in production.
#
# Both are optional: only app/lib/supabase/client.ts (opt-in client-side realtime) reads them.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key
