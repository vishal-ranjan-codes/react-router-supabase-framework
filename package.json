{
  "name": "react-router-supabase-framework",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261019.1": true
  },
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "preview": "npm run build && vite preview",
    "typecheck": "wrangler types && react-router typegen && tsc -b",
    "cf-typegen": "wrangler types",
    "deploy": "react-router build && wrangler deploy",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check:ds": "node scripts/check-design-system.mjs",
    "ds:drift": "node scripts/ds-drift.mjs",
    "ds:add": "npx shadcn@4.23.0 add --overwrite --yes"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2",
    "class-variance-authority": "^0.7",
    "clsx": "^2",
    "cn": "^0.5.0",
    "embla-carousel-react": "^8",
    "input-otp": "^1",
    "isbot": "^5.1.36",
    "lucide-react": "^0.474",
    "radix-ui": "^1.8.1",
    "react": "^19.2.7",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7",
    "react-resizable-panels": "^4.15.0",
    "react-router": "^8",
    "sonner": "^2",
    "tailwind-merge": "^3",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1",
    "zod": "^3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "^2.6.3",
    "@cloudflare/vite-plugin": "^1.52.1",
    "@playwright/test": "^1.62.1",
    "@react-router/dev": "^8",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.12",
    "happy-dom": "^20.11.12",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.123.0"
  }
}
