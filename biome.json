{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!package-lock.json",
      "!pnpm-lock.yaml",
      "!.docs",
      "!.visual-harness",
      "!app/types/database.types.ts",
      "!app/globals.css",
      "!.react-router",
      "!supabase-email-templates"
    ]
  },
  "overrides": [
    {
      "includes": ["app/components/ui/**"],
      "linter": {
        "enabled": false
      },
      "assist": {
        "enabled": false
      }
    }
  ],
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80,
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
